# Copier en .env.local (jamais committé). Voir README.md « Démarrage ».

# Neon : chaîne « pooled » de la branche dev en local ; celle de production uniquement sur Vercel.
DATABASE_URL=

# Auth.js — secret de session (différent en dev et en production).
AUTH_SECRET=
# Google Cloud Console → Identifiants → ID client OAuth « Application Web ».
# URI de redirection : http://localhost:3000/api/auth/callback/google (et le domaine de prod).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Adresse Google du premier administrateur (utilisée par npm run db:seed).
ADMIN_EMAIL=

# Connexion de démonstration, développement local uniquement (ignorée en production)
AUTH_DEV_LOGIN=

# Envoi d'images (affiches, plannings, logos) : cloudinary.com → Settings → API Keys.
# Sans ces valeurs, l'envoi d'images est désactivé (les clubs gardent leur logo par défaut).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails : SMTP de Google (Gmail). Compte d'envoi + mot de passe d'application
# (myaccount.google.com → Sécurité → Validation en deux étapes → Mots de passe des applications).
# Sans ces valeurs, les emails sont seulement affichés dans le terminal.
SMTP_USER=
SMTP_PASS=
# Facultatif : expéditeur affiché (l'adresse doit être celle du compte ou un alias vérifié dans Gmail).
EMAIL_FROM="ENSATE clubs <adresse.du.compte@gmail.com>"
# Facultatif : autre serveur SMTP (par défaut smtp.gmail.com, port 465).
SMTP_HOST=
SMTP_PORT=
# Adresse publique du site (liens dans les emails). Sur Vercel, l'adresse de production est utilisée par défaut.
APP_URL=

# Tâche planifiée (Vercel Cron) : secret aléatoire, différent en production.
CRON_SECRET=
