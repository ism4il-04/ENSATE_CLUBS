# Copier en .env.local (jamais committé). Voir README.md « Démarrage ».

# Neon : chaîne « pooled » de la branche dev en local ; celle de production uniquement sur Vercel.
DATABASE_URL=

# Auth.js — secret de session (différent en dev et en production).
AUTH_SECRET=
# Google Cloud Console → Identifiants → ID client OAuth « Application Web ».
# URI de redirection : http://localhost:3000/api/auth/callback/google (et le domaine de prod).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Adresse Google du premier administrateur (utilisée par npm run db:seed).
ADMIN_EMAIL=

# Connexion de démonstration, développement local uniquement (ignorée en production)
AUTH_DEV_LOGIN=

# Envoi d'images (affiches, plannings, logos) : cloudinary.com → Settings → API Keys.
# Sans ces valeurs, les clubs collent un lien https vers l'image.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
